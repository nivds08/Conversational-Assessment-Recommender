# Required: Groq API key for intent classification (llama-3.1-8b-instant)
GROQ_API_KEY=

# Optional but recommended: Hugging Face token for sentence-transformers / Hub access
# Create at https://huggingface.co/settings/tokens (read access is enough for public models)
# Also accepted by libraries as HUGGINGFACE_HUB_TOKEN if you prefer that name locally.
HF_TOKEN=
